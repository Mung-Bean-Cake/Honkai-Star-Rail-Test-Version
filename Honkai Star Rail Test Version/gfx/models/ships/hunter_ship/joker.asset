entity = {
	name = "joker_frame_entity"
	pdxmesh = crystal_ship_large_green_elite_mesh
	locator = { name = "part1"	position = { 0 0  16.0 }	rotation = { 0 0 0 } }
	locator = { name = "part2"	position = { 0 0 -10.0 }	rotation = { 0 0 0 } }
	default_state = "idle"
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 4
		start_event = {
			trigger_once = yes
			sound = { soundeffect = "amb_cruiser_hum" }
		}
	}
	state = {
		name = "moving"
		animation = "idle"
		animation_blend_time = 2
		event = {
			trigger_once = yes
			sound = { soundeffect = "moving_out_cruiser" }
		}
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.0
		chance = 1
		looping = no
		event = {
			time = 3.4
			node = "part2"
			particle = "ship_explosion_particle"
			sound = { soundeffect = "ship_explosion" }
		}
	}
}

